<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChaosStrap.MainWindow"
        Width="1120" Height="740" MinWidth="920" MinHeight="620"
        Title="ChaosStrap" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="238,*" RowDefinitions="*">
    <Border Grid.Column="0" Background="#101016" BorderBrush="#25252D" BorderThickness="0,0,1,0" Padding="18">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,4,0,28">
          <Border Width="42" Height="42" CornerRadius="12" Background="#1C1116" ClipToBounds="True">
            <Image Source="/Assets/chaosstrap-mark.png" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="CHAOSSTRAP" FontSize="16" FontWeight="Bold" LetterSpacing="1.4" />
            <TextBlock Text="by xphantomcorp" FontSize="10" Foreground="#85858F" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="LAUNCHER" Foreground="#666671" FontSize="10" FontWeight="Bold" LetterSpacing="1.8" Margin="10,0,0,10" />
        <StackPanel Grid.Row="2" Spacing="5">
          <Button Classes="nav" Tag="Home" Click="Navigate_Click" Background="#28141A" Foreground="#FF5267">◈   Overview</Button>
          <Button Classes="nav" Tag="FastFlags" Click="Navigate_Click">⚑   FastFlags</Button>
          <Button Classes="nav" Tag="Mods" Click="Navigate_Click">▧   Mod Manager</Button>
          <Button Classes="nav" Tag="Appearance" Click="Navigate_Click">◐   Appearance</Button>
          <Button Classes="nav" Tag="Settings" Click="Navigate_Click">⚙   Settings</Button>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="7">
          <Border Height="1" Background="#292932" Margin="0,0,0,8" />
          <TextBlock Text="CHAOSSTRAP  •  EARLY BUILD" FontSize="9" Foreground="#666671" HorizontalAlignment="Center" />
          <TextBlock Text="Built for a better Roblox launch." FontSize="10" Foreground="#85858F" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="30,24,30,26">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="3">
          <TextBlock x:Name="PageEyebrow" Text="CHAOSSTRAP / HOME" FontSize="10" Foreground="#E84A5F" FontWeight="Bold" LetterSpacing="1.6" />
          <TextBlock x:Name="PageTitle" Text="Your Roblox, your rules." FontSize="27" FontWeight="SemiBold" />
        </StackPanel>
        <Border Grid.Column="1" Background="#17171E" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="7" Height="7" Fill="#E83C52" VerticalAlignment="Center" />
            <TextBlock x:Name="InstallStatus" Text="Checking Roblox…" FontSize="11" Foreground="#C6C6CE" />
          </StackPanel>
        </Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="HomePage" Spacing="18">
            <Border Classes="panel" Padding="26" Background="#171219">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="THE BETTER WAY TO PLAY" Foreground="#FF5369" FontSize="10" FontWeight="Bold" LetterSpacing="1.8" />
                  <TextBlock Text="Ready when you are." FontSize="30" FontWeight="SemiBold" />
                  <TextBlock Text="Launch Roblox with ChaosStrap. Your setup, your preferences, your control." Foreground="#A5A2AA" FontSize="13" MaxWidth="520" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button Classes="action" Click="Launch_Click">▶   Launch Roblox</Button>
                    <Button Classes="secondary" Click="Refresh_Click">Refresh status</Button>
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="170" Height="170" Background="#1B1015" CornerRadius="24" Padding="12" VerticalAlignment="Center">
                  <Image Source="/Assets/chaosstrap-mark.png" Stretch="Uniform" />
                </Border>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Classes="panel" Padding="20">
                <StackPanel Spacing="8">
                  <TextBlock Text="ROBLOX INSTALLATION" Foreground="#898994" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" />
                  <TextBlock x:Name="InstallValue" Text="Detecting…" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="InstallPath" Text="Looking for Roblox Player" Foreground="#85858F" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel" Padding="20">
                <StackPanel Spacing="8">
                  <TextBlock Text="QUICK ACCESS" Foreground="#898994" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" />
                  <Button Classes="secondary" HorizontalAlignment="Left" Click="OpenInstall_Click">Open Roblox folder  ↗</Button>
                  <Button Classes="secondary" HorizontalAlignment="Left" Click="OpenWebsite_Click">Roblox website  ↗</Button>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel" Padding="20">
              <StackPanel Spacing="7">
                <TextBlock Text="WHAT'S NEXT" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="ChaosStrap is being built as an independent launcher. The first foundation includes installation detection, launching, local settings and a FastFlag editor. More systems will be added in tested stages." Foreground="#A5A5AE" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="FastFlagsPage" IsVisible="False" Spacing="14">
            <Border Classes="panel" Padding="20">
              <StackPanel Spacing="8">
                <TextBlock Text="FASTFLAG EDITOR" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Edit the local ClientAppSettings.json file. Only use flags you understand; Roblox may ignore or remove unsupported flags." Foreground="#A5A5AE" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="FastFlagPath" Foreground="#777783" FontSize="10" TextWrapping="Wrap" />
                <TextBox x:Name="FastFlagEditor" AcceptsReturn="True" MinHeight="300" FontFamily="Cascadia Code,Consolas" FontSize="12" TextWrapping="NoWrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="action" Click="SaveFlags_Click">Save FastFlags</Button>
                  <Button Classes="secondary" Click="ReloadFlags_Click">Reload file</Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ModsPage" IsVisible="False" Spacing="14">
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="10">
                <TextBlock Text="MOD MANAGER" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="The independent mod system is not implemented yet. This page is reserved for safe local asset management, per-install profiles and reversible mod deployment." Foreground="#A5A5AE" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="IN DEVELOPMENT" Foreground="#FF5369" FontSize="10" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="AppearancePage" IsVisible="False" Spacing="14">
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="10">
                <TextBlock Text="APPEARANCE" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Chaos Crimson" Foreground="#FF5369" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="A dark graphite interface with restrained crimson accents, inspired by the ChaosStrap emblem." Foreground="#A5A5AE" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" IsVisible="False" Spacing="14">
            <Border Classes="panel" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock Text="GENERAL SETTINGS" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="CloseAfterLaunch" Content="Close ChaosStrap after launching Roblox" />
                <CheckBox x:Name="CheckUpdates" Content="Check for ChaosStrap updates on startup" />
                <CheckBox x:Name="RichPresence" Content="Enable Discord Rich Presence (coming soon)" IsEnabled="False" />
                <Button Classes="action" HorizontalAlignment="Left" Click="SaveSettings_Click">Save settings</Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
