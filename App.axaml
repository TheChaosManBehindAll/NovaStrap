<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChaosStrap.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0C0C10" />
      <Setter Property="Foreground" Value="#F4F4F6" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A5A5AE" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#1C1C24" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#E51D35" /><Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="18,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action:pointerover"><Setter Property="Background" Value="#FF334B" /></Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#202027" /><Setter Property="Foreground" Value="#E7E7EB" />
      <Setter Property="BorderBrush" Value="#34343D" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#15151C" /><Setter Property="BorderBrush" Value="#292932" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#101016" /><Setter Property="Foreground" Value="#F4F4F6" /><Setter Property="BorderBrush" Value="#34343D" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="10" /></Style>
  </Application.Styles>
</Application>
